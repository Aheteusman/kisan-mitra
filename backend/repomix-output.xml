    expect(createCall.data.passwordHash).toMatch(/^\$2b\$/);

    // OtpRecord created
    expect(prisma.otpRecord.create).toHaveBeenCalledTimes(1);

    // devOtp returned
    expect(result).toHaveProperty('userId', 'user-1');
